NODE_ENV=development
DATABASE_URL=file:./data/agent-treasury.db
AGENT_MODEL=openai:Beam-1.0-501B-A23B
OPENAI_BASE_URL=https://api.reflection.ai/openai/v1
OPENAI_API_KEY=

# Robinhood Chain Testnet
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
CHAIN_ID=46630
CHAIN_NAME="Robinhood Chain Testnet"
RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
MOCK_WIF_ADDRESS=0x8187DC056F36dF72694D1CA830c518FD5D542DbC
TOKEN_SYMBOL=tWIF
CHAIN_CONFIRMATIONS=1
DEMO_TOKEN_PRICE_USD=0.02

# Comma-separated signer private keys for the demo agents. Never expose these.
DEMO_SIGNER_KEYS=

# A423 workflow bearer tokens: JSON map of agentId -> token (>=16 chars).
A423_AGENT_TOKENS=

# A423 0.5 escrow on Robinhood Chain Testnet
A423_CHAIN_ID=46630
A423_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
A423_TOKEN_ADDRESS=0x8187DC056F36dF72694D1CA830c518FD5D542DbC
A423_ESCROW_ADDRESS=
A423_ESCROW_VERSION=0.5
A423_CONFIRMATIONS=1
A423_EVIDENCE_REVALIDATION=off
A423_INDEX_FROM_BLOCK=
A423_STORAGE_FILE=data/a423-operations.sqlite
A423_DEPLOYER_SIGNER_INDEX=1
A423_DEPLOY_CONFIRM=
A423_ARBITER_ID=a423-arbiter
A423_ARBITER_SIGNER_INDEX=2
A423_ARBITER_ADDRESS=
A423_ARBITER_WALLET_KEY_PATH=.a423/arbiter-04-wallet.json
A423_DASHBOARD_ACTOR=

# Identity / authority
A423_AUTHORITY_KEY_PATH=.a423/authority-04.pem
A423_AUTHORITY_ISSUER=a423-local-authority
A423_AUTHORITY_AUDIENCE=a423-local-app
A423_ORGS_CONFIG=config/a423-organizations.json
A423_PRIVATE_KEYS=.a423/a423-private-keys.json
A423_CHALLENGE_TTL_MS=300000
A423_CREDENTIAL_TTL_MS=86400000
A423_REQUIRE_VERIFIED_AGENTS=true
A423_ALLOW_BOOTSTRAP=false
A423_AUTH_ALLOW_ANY=false

# Signing / mandates
A423_ALLOW_SIGNING=true
A423_SERVER_CONSENT=false
A423_LIMIT_PER_TX=1000000000000000000000
A423_LIMIT_DAILY=5000000000000000000000
A423_LIMIT_TOTAL=20000000000000000000000
A423_MANDATE_A_ID=robinhood-buyer-v2
A423_MANDATE_A_TOTAL=1000000000000000000000
A423_MANDATE_A_PER_TX=100000000000000000000
A423_MANDATE_A_DAILY=500000000000000000000
A423_MANDATE_A_WEEKS=4
A423_KEEPER_ENABLED=true
A423_FORWARD_CANCELLATIONS=false

# Worker / chat
A423_CHAT_MODE=sdk
A423_WORKER_INTERVAL_MS=5000
A423_WORKER_UI=true
A423_PEER_NOTIFICATIONS=true
A423_PEER_DELIVER_ONLY=false
A423_MAX_NEGOTIATION_REVISIONS=4
A423_QUOTE_TTL_MS=900000
A423_WEBHOOK_SUBSCRIPTIONS=[]
A423_WEBHOOK_SECRETS={}

# Simulated work meter / profit policy
A423_MOCK_TASK_MINUTES=2
A423_MOCK_TOKENS_PER_MINUTE=2400
A423_MOCK_LLM_TOKEN_COST_USD=0.00005
A423_TARGET_MARGIN_BPS=5000
A423_MIN_MARGIN_BPS=1000
A423_MAX_MARGIN_BPS=5000
A423_REQUIRE_COUNTER=true
